fn main() {
    int before = clock();

    // ----------
    
    println("hello world");
    sdl2_create_window("SDL2 window with crust", 720, 480);

    bool quit = false;
    int frame_count = 0;
    int time = clock();

    while (!quit) {
        sdl2_clear_screen();
        quit = sdl2_handle_events();
        sdl2_update_screen();

        frame_count += 1;

        if (clock() > time + 1) {
            print("fps: ");
            println(frame_count);
            frame_count = 0;
            time = clock();
        }
    }

    // ----------
    
    int after = clock();
    println(after - before);
}

main();

